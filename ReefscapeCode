# ==========================================
# 5. ASYNC SERVER & MOTOR WATCHDOG
# ==========================================
async def handle_client(reader, writer):
    try:
        request_line = await reader.readline()
        if not request_line:
            return
            
        req = request_line.decode('utf-8')
        headers = {}
        
        while True:
            line = await reader.readline()
            if line == b'\r\n' or line == b'':
                break
            parts = line.decode('utf-8').split(':', 1)
            if len(parts) == 2:
                headers[parts[0].strip().lower()] = parts[1].strip()

        path = req.split(' ')[1].split('?')[0] if len(req.split(' ')) > 1 else ''

        # WebSocket Upgrade Endpoint
        if path == '/ws' and 'sec-websocket-key' in headers:
            handshake = generate_ws_handshake(headers['sec-websocket-key'])
            writer.write(handshake.encode('utf-8'))
            await writer.drain()
            
            while True:
                msg = await read_ws_message(reader)
                if not msg:
                    break
                
                # Single-byte Servo Command
                if len(msg) == 1:
                    cmd = msg[0]
                    if cmd == 1: await apply_position('1')
                    elif cmd == 2: await apply_position('2')
                    elif cmd == 22: await apply_position('22')
                    elif cmd == 3: await apply_position('3')
                    elif cmd == 33: await apply_position('33')
                    elif cmd == 4: await apply_position('4')
                    elif cmd == 44: await apply_position('44')
                    elif cmd == 105: await apply_position('i')
                    elif cmd == 106: await apply_position('ii')
                    elif cmd == 5: await apply_position('5')

                # 4-byte Mecanum Drive Packet [0x01, Strafe_X, Drive_Y, Turn_X]
                elif len(msg) >= 4 and msg[0] == 0x01:
                    strafe_x, drive_y, turn_x = ustruct.unpack('bbb', msg[1:4])
                    apply_mecanum_drive(strafe_x, drive_y, turn_x)

        # Serve Static Webpage
        else:
            writer.write("HTTP/1.1 200 OK\r\nContent-Type: text/html\r\nConnection: close\r\n\r\n" + HTML_PAGE)
            await writer.drain()
            await writer.wait_closed()

    except Exception:
        pass

async def motor_watchdog():
    global motor_is_running
    while True:
        if motor_is_running and time.ticks_diff(time.ticks_ms(), last_drive_packet) > 400:
            stop_motors()
            motor_is_running = False
            
        gc.collect()
        await asyncio.sleep_ms(100)

async def main():
    print("Starting WebSocket Mecanum Server...")
    asyncio.create_task(motor_watchdog())
    server = await asyncio.start_server(handle_client, "0.0.0.0", 80)
    
    while True:
        await asyncio.sleep(3600)

try:
    asyncio.run(main())
except KeyboardInterrupt:
    stop_motors()
    print("Server stopped.")
