def set_servo_angle(channel, angle):
    duty = int(102 + (angle / 180.0) * (512 - 102))
    pca.duty(channel, duty)

async def apply_position(pos):
    global current_angles
    if pos in SERVO_POSITIONS:
        data = SERVO_POSITIONS[pos]
        target_angles = data[0:3]
        speed = max(0.01, min(1.0, data[3]))

        step_delay_ms = int((1.0 - speed) * 15)
        max_diff = max(abs(target_angles[i] - current_angles[i]) for i in range(3))
        
        if max_diff == 0 or speed == 1.0:
            for idx, ch in enumerate(SERVO_CHANNELS):
                set_servo_angle(ch, target_angles[idx])
                current_angles[idx] = target_angles[idx]
        else:
            steps = max_diff
            for step in range(1, steps + 1):
                for idx, ch in enumerate(SERVO_CHANNELS):
                    start = current_angles[idx]
                    target = target_angles[idx]
                    current = start + (target - start) * (step / steps)
                    set_servo_angle(ch, current)
                
                if step_delay_ms > 0:
                    await asyncio.sleep_ms(step_delay_ms)
            
            current_angles = list(target_angles)
            
        print(f"[SERVO] Position {pos} applied")

def stop_motors():
    fl_pwm.duty_u16(0); rl_pwm.duty_u16(0)
    fr_pwm.duty_u16(0); rr_pwm.duty_u16(0)
    fl_in1.value(0); fl_in2.value(0)
    rl_in1.value(0); rl_in2.value(0)
    fr_in1.value(0); fr_in2.value(0)
    rr_in1.value(0); rr_in2.value(0)

last_drive_packet = 0
motor_is_running = False

def apply_mecanum_drive(strafe_x, drive_y, turn_x):
    global last_drive_packet, motor_is_running
    last_drive_packet = time.ticks_ms()

    # Disable turning if flag is set to False
    if not ENABLE_TURNING:
        turn_x = 0

    if strafe_x == 0 and drive_y == 0 and turn_x == 0:
        stop_motors()
        motor_is_running = False
        return

    motor_is_running = True

    # Mecanum wheel vector mixing equations (strafe_x inverted for rear wheels)
    fl_speed = drive_y + strafe_x + turn_x
    rl_speed = drive_y + strafe_x - turn_x  # Inverted strafe_x sign
    fr_speed = drive_y - strafe_x - turn_x
    rr_speed = drive_y - strafe_x + turn_x  # Inverted strafe_x sign

    # Clamp values between -100 and 100
    fl_speed = max(-100, min(100, fl_speed))
    rl_speed = max(-100, min(100, rl_speed))
    fr_speed = max(-100, min(100, fr_speed))
    rr_speed = max(-100, min(100, rr_speed))

    # Convert speeds (-100 to 100) to 16-bit PWM duty cycles
    fl_duty = int((abs(fl_speed) / 100.0) * MOTOR_SPEED)
    rl_duty = int((abs(rl_speed) / 100.0) * MOTOR_SPEED)
    fr_duty = int((abs(fr_speed) / 100.0) * MOTOR_SPEED)
    rr_duty = int((abs(rr_speed) / 100.0) * MOTOR_SPEED)

    fl_pwm.duty_u16(fl_duty); rl_pwm.duty_u16(rl_duty)
    fr_pwm.duty_u16(fr_duty); rr_pwm.duty_u16(rr_duty)

    # Set motor directions
    fl_in1.value(1 if fl_speed > 0 else 0); fl_in2.value(1 if fl_speed < 0 else 0)
    rl_in1.value(1 if rl_speed < 0 else 0); rl_in2.value(1 if rl_speed > 0 else 0)
    fr_in1.value(1 if fr_speed > 0 else 0); fr_in2.value(1 if fr_speed < 0 else 0)
    rr_in1.value(1 if rr_speed < 0 else 0); rr_in2.value(1 if rr_speed > 0 else 0)

