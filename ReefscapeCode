class PCA9685:
    def __init__(self, i2c, address=0x40):
        self.i2c = i2c
        self.address = address
        self.reset()

    def _write(self, reg, val):
        try:
            self.i2c.writeto_mem(self.address, reg, bytearray([val]))
        except Exception as e:
            print("[I2C Write Error]", e)

    def _read(self, reg):
        try:
            return self.i2c.readfrom_mem(self.address, reg, 1)[0]
        except Exception as e:
            print("[I2C Read Error]", e)
            return 0

    def reset(self):
        self._write(0x00, 0x00)
        time.sleep_ms(10)

    def freq(self, freq=None):
        if freq is None:
            return int(25000000 / (4096 * (self._read(0xFE) + 1)))
        prescale = int(25000000.0 / (4096.0 * freq) - 0.5)
        oldmode = self._read(0x00)
        newmode = (oldmode & 0x7F) | 0x10
        self._write(0x00, newmode)
        self._write(0xFE, prescale)
        self._write(0x00, oldmode)
        time.sleep_ms(5)
        self._write(0x00, oldmode | 0xA1)

    def duty(self, index, value=None):
        value = min(4095, max(0, value))
        data = ustruct.pack('<HH', 0, value)
        try:
            self.i2c.writeto_mem(self.address, 0x06 + 4 * index, data)
        except Exception as e:
            print("[I2C Duty Error]", e)

