        }

        function triggerStepSequence(stepByte, delayMs = 800) {
            if (isTransitioning) return;
            isTransitioning = true;
            lastPosSent = stepByte;
            sendByte(stepByte);
            
            setTimeout(() => {
                lastPosSent = 5;
                sendByte(5);
                isTransitioning = false;
            }, delayMs);
        }

        function sendJoystickState(strafeX, driveY, turnX) {
            if (!ws || ws.readyState !== WebSocket.OPEN) return;

            const cStrafe = Math.max(-100, Math.min(100, Math.round(strafeX)));
            const cDrive = Math.max(-100, Math.min(100, Math.round(driveY)));
            const cTurn = Math.max(-100, Math.min(100, Math.round(turnX)));

            // 4-byte packet: [Header 0x01, Strafe_X, Drive_Y, Turn_X]
            const buffer = new ArrayBuffer(4);
            const view = new DataView(buffer);
            view.setUint8(0, 0x01);     // Drive Header
            view.setInt8(1, cStrafe);   // Strafe Right/Left
            view.setInt8(2, cDrive);    // Forward/Backward
            view.setInt8(3, cTurn);     // Turn Right/Left
