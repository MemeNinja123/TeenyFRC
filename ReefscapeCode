# 3. WEBSOCKET HELPERS
# ==========================================
WS_MAGIC = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

def generate_ws_handshake(sec_key):
    combined = sec_key.strip() + WS_MAGIC
    sha1_hash = hashlib.sha1(combined.encode('utf-8')).digest()
    accept_key = ubinascii.b2a_base64(sha1_hash).decode('utf-8').strip()
    return (
        "HTTP/1.1 101 Switching Protocols\r\n"
        "Upgrade: websocket\r\n"
        "Connection: Upgrade\r\n"
        f"Sec-WebSocket-Accept: {accept_key}\r\n\r\n"
    )

async def read_ws_message(reader):
    try:
        header = await reader.read(2)
        if not header or len(header) < 2:
            return None
            
        payload_len = header[1] & 127
        is_masked = bool(header[1] & 128)
        
        if payload_len == 126:
            ext_len = await reader.read(2)
            payload_len = int.from_bytes(ext_len, 'big')
            
        masks = await reader.read(4) if is_masked else None
        data = await reader.read(payload_len)
        
        if is_masked and masks:
            data = bytearray(b ^ masks[i % 4] for i, b in enumerate(data))
            
        return data
    except Exception:
        return None

